// Konfiguration des Cloudflare Workers (siehe README, „Variante A: Cloudflare Worker“).
// Deploy: cd worker && npm install && npx wrangler login && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volleyballturnier",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "TOURNAMENT", "class_name": "Tournament" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tournament"] }]
  // Optional: Aufrufe nur von der eigenen GitHub-Pages-Seite zulassen, z. B.
  // "vars": { "ALLOWED_ORIGINS": "https://<benutzername>.github.io" }
}
