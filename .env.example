# Port des Webservers
PORT=3000
# PIN für den Admin-Bereich (unbedingt ändern!)
ADMIN_PIN=1234
# Öffentliche Basis-URL, die in die QR-Codes kodiert wird (z. B. http://192.168.0.10:3000)
# Wenn leer, wird die Adresse verwendet, über die die Druckseite aufgerufen wurde.
PUBLIC_URL=
# Ablageort der Turnierdaten
DATA_FILE=./data/turnier.json
